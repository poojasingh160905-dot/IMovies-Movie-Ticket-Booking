# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Replace with your local MongoDB or MongoDB Atlas URI)
# Example for local MongoDB: mongodb://127.0.0.1:27017/imovies
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Secret & Expiry
JWT_SECRET=your_jwt_secret_key_here_imovies_2024
JWT_EXPIRES_IN=7d
